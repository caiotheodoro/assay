__pycache__/
*.pyc
.venv/
.pytest_cache/

# uv.lock IS tracked. `openenv` is pinned to a git revision because an audit
# whose subject moves between runs is not an audit -- and that argument applies
# with equal force to `inspect-ai>=0.3.260` and `inspect_evals~=0.18.0`, whose
# ranges are open. The lockfile is what makes the two defect write-ups in the
# README reproducible against the versions they were found in.

# Results are evidence, not scratch. The brief asks that every claim about a
# result be connected to the evidence submitted, and a judge should be able to
# read the numbers without running anything first. So the headline artefacts are
# tracked, and only bulk is excluded.
results/**/rewards.jsonl
results/**/*.safetensors
results/**/checkpoints/

# Staging area for scripts/publish_hf.py. Regenerated from tracked evidence on
# every run, and it holds the fetched adapter weights, so it is scratch by
# construction -- the published copy lives on the Hub, the reproducible copy is
# the script.
build/

# Third-party checkouts the BenchGuard scoring run needs at runtime: a clone of
# XinmingTu/BenchGuard (its gold set quotes ScienceAgentBench instructions),
# IsThatYou/auto-bench-audit's converter, and the drop path for SAB's gated
# archive. Verdicts about other people's benchmarks ship; their copies do not
# -- scripts/sab_benchguard_recall.py takes these as paths so a reader clones
# them at the shas recorded in results/sab_benchguard/.
third_party/

# Intermediates of the BenchGuard scoring run. The audit records and the
# normalized findings restate SAB's declared output paths per task; the reports
# carry BenchGuard's gold wording. Only the redacted *_result.json is tracked.
results/sab_benchguard/*/audits/
results/sab_benchguard/*/normalized/
results/sab_benchguard/*/matches/
results/sab_benchguard/*/reports/
# Two pinned third-party benchmark snapshots, fetched by
# scripts/tau2_fetch.py. Verdicts about tau2-bench ship; tau2-bench does not.
.tau2_cache/

# Challenger sandbox residue: these are exploit payloads, not artifacts.
# They reached the repo root once (commit 47ca9a8) and were committed.
out.txt
expected.txt
results/wild_sweep.json
results/agentic_runs/
