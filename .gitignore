__pycache__/
*.pyc
.venv/
.pytest_cache/

# uv.lock IS tracked. `openenv` is pinned to a git revision because an audit
# whose subject moves between runs is not an audit -- and that argument applies
# with equal force to `inspect-ai>=0.3.260` and `inspect_evals~=0.18.0`, whose
# ranges are open. The lockfile is what makes the two defect write-ups in the
# README reproducible against the versions they were found in.

# Results are evidence, not scratch. The brief asks that every claim about a
# result be connected to the evidence submitted, and a judge should be able to
# read the numbers without running anything first. So the headline artefacts are
# tracked, and only bulk is excluded.
results/**/rewards.jsonl
results/**/*.safetensors
results/**/checkpoints/

# Staging area for scripts/publish_hf.py. Regenerated from tracked evidence on
# every run, and it holds the fetched adapter weights, so it is scratch by
# construction -- the published copy lives on the Hub, the reproducible copy is
# the script.
build/
